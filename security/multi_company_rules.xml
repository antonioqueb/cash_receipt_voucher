<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas multiempresa: cada compañía ve solo su caja. La de
             petty.cash.entry vive en cash_receipt_security.xml. -->
        <record id="rule_cash_receipt_company" model="ir.rule">
            <field name="name">Recibo de Efectivo: multiempresa</field>
            <field name="model_id" ref="model_cash_receipt"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_cash_entry_company" model="ir.rule">
            <field name="name">Entrada de Caja: multiempresa</field>
            <field name="model_id" ref="model_cash_entry"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_cash_disbursement_company" model="ir.rule">
            <field name="name">Salida de Caja: multiempresa</field>
            <field name="model_id" ref="model_cash_disbursement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
