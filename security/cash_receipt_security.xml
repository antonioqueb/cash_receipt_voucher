<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Categoría dedicada para el permiso de control interno de efectivo -->
        <record id="module_category_cash_control" model="ir.module.category">
            <field name="name">Control Interno de Efectivo</field>
            <field name="description">Gestión del control interno (efectivo
                realmente ingresado a caja) sobre los recibos de efectivo.</field>
            <field name="sequence">90</field>
        </record>

        <!-- Privilegio: agrupa los niveles y los muestra como SELECTOR en el
             formulario del usuario (Odoo 19). -->
        <record id="privilege_cash_internal_control" model="res.groups.privilege">
            <field name="name">Control Interno de Efectivo</field>
            <field name="category_id" ref="module_category_cash_control"/>
            <field name="sequence">90</field>
        </record>

        <!-- Nivel 1 — Consulta: ve el efectivo real y el reporte de control
             interno en SOLO LECTURA. -->
        <record id="group_cash_internal_control" model="res.groups">
            <field name="name">Consulta</field>
            <field name="privilege_id" ref="privilege_cash_internal_control"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Puede ver el "Efectivo Real (Control Interno)",
                la diferencia de caja y el Reporte de Control Interno de Efectivo,
                pero NO puede modificarlos.</field>
        </record>

        <!-- Nivel 2 — Ajuste: ve y además puede MODIFICAR el efectivo real.
             Incluye el nivel de Consulta. -->
        <record id="group_cash_internal_control_edit" model="res.groups">
            <field name="name">Ajuste de Efectivo Real</field>
            <field name="privilege_id" ref="privilege_cash_internal_control"/>
            <field name="implied_ids" eval="[(4, ref('group_cash_internal_control'))]"/>
            <field name="comment">Puede ajustar el "Efectivo Real (Control Interno)"
                de los recibos, independiente del monto oficial. El monto oficial,
                el recibo PDF, el estado de cuenta y la contabilidad no se ven
                afectados.</field>
        </record>


        <!-- ===================== CAJA CHICA OPERACIONES ===================== -->
        <record id="module_category_petty_cash" model="ir.module.category">
            <field name="name">Caja Chica</field>
            <field name="description">Fondo de caja chica operaciones: recepción de fondos y egresos menores.</field>
            <field name="sequence">91</field>
        </record>
        <record id="privilege_petty_cash" model="res.groups.privilege">
            <field name="name">Caja Chica</field>
            <field name="category_id" ref="module_category_petty_cash"/>
            <field name="sequence">91</field>
        </record>
        <!-- Operador: recibe fondos, registra ingresos/egresos, consulta y reportea. -->
        <record id="group_petty_cash_user" model="res.groups">
            <field name="name">Operador</field>
            <field name="privilege_id" ref="privilege_petty_cash"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Opera la Caja Chica: confirma fondos recibidos, registra egresos e ingresos y consulta el panel.</field>
        </record>
        <!-- Responsable: además cancela movimientos con motivo y administra categorías. -->
        <record id="group_petty_cash_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="privilege_id" ref="privilege_petty_cash"/>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
            <field name="comment">Todo lo del Operador más cancelar movimientos (con motivo) y administrar categorías.</field>
        </record>

        <record id="petty_cash_entry_company_rule" model="ir.rule">
            <field name="name">Caja Chica: multi-compañía</field>
            <field name="model_id" ref="model_petty_cash_entry"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
