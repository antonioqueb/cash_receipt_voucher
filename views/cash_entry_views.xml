<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cash_entry_list" model="ir.ui.view">
        <field name="name">cash.entry.list</field>
        <field name="model">cash.entry</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-warning="amount_internal_diff &gt; 0"
                  decoration-info="amount_internal_diff &lt; 0"
                  default_order="date desc">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" optional="show"/>
                <field name="received_from" optional="hide"/>
                <field name="sale_order_ids" widget="many2many_tags" optional="show"/>
                <field name="receipt_id" optional="show"/>
                <field name="amount" sum="Recibido" string="Recibido"/>
                <field name="amount_internal" sum="A Cuenta" string="A Cuenta"/>
                <field name="amount_internal_diff" sum="En Caja" string="En Caja"/>
                <field name="currency_id" string="Div" optional="show"/>
                <field name="mxn_currency_id" column_invisible="1"/>
                <field name="amount_mxn" sum="Recibido MXN" string="MXN" optional="hide"/>
                <field name="is_usd" column_invisible="1"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_cash_entry_form" model="ir.ui.view">
        <field name="name">cash.entry.form</field>
        <field name="model">cash.entry</field>
        <field name="arch" type="xml">
            <form string="Entrada de Caja">
                <header>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state != 'done'"
                            confirm="¿Cancelar esta entrada de caja? El saldo de caja disminuirá."
                            groups="cash_receipt_voucher.group_cash_internal_control_edit"/>
                    <button name="action_restore" type="object" string="Restaurar"
                            invisible="state != 'cancelled'"
                            groups="cash_receipt_voucher.group_cash_internal_control_edit"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="can_adjust_internal" invisible="1"/>
                    <group>
                        <group string="Efectivo">
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="amount_internal" readonly="not can_adjust_internal"/>
                            <field name="amount_internal_diff"/>
                            <field name="internal_diff_reason" readonly="not can_adjust_internal"
                                   invisible="not has_internal_diff and not internal_diff_reason"/>
                            <field name="has_internal_diff" invisible="1"/>
                            <field name="amount_mxn" string="Equivalente MXN"/>
                        </group>
                        <group string="Origen y Referencias">
                            <field name="partner_id"/>
                            <field name="received_from"/>
                            <field name="sale_order_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="receipt_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="internal_adjusted_by"
                                   invisible="not internal_adjusted_by"/>
                            <field name="internal_adjusted_date"
                                   invisible="not internal_adjusted_date"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="concept" nolabel="1"
                               placeholder="Concepto u origen del efectivo (cobro, anticipo, reposición de caja, etc.)"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cash_entry_search" model="ir.ui.view">
        <field name="name">cash.entry.search</field>
        <field name="model">cash.entry</field>
        <field name="arch" type="xml">
            <search string="Entradas de Caja">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="received_from"/>
                <field name="sale_order_ids"/>
                <field name="receipt_id"/>
                <filter string="Con efectivo en caja" name="shortage"
                        domain="[('amount_internal_diff', '&gt;', 0)]"/>
                <filter string="Solo con diferencia" name="only_diff"
                        domain="[('has_internal_diff', '=', True)]"/>
                <separator/>
                <filter string="Con recibo" name="with_receipt"
                        domain="[('receipt_id', '!=', False)]"/>
                <filter string="Captura suelta (sin recibo)" name="without_receipt"
                        domain="[('receipt_id', '=', False)]"/>
                <separator/>
                <filter string="Solo USD" name="only_usd" domain="[('is_usd', '=', True)]"/>
                <filter string="Solo MXN" name="only_mxn" domain="[('is_usd', '=', False)]"/>
                <separator/>
                <filter string="No canceladas" name="not_cancelled"
                        domain="[('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter string="Cliente" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Divisa" name="group_currency"
                        context="{'group_by': 'currency_id'}"/>
                <filter string="Mes" name="group_date"
                        context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_cash_entry_pivot" model="ir.ui.view">
        <field name="name">cash.entry.pivot</field>
        <field name="model">cash.entry</field>
        <field name="arch" type="xml">
            <pivot string="Entradas de Caja">
                <field name="partner_id" type="row"/>
                <field name="amount" type="measure"/>
                <field name="amount_internal" type="measure"/>
                <field name="amount_internal_diff" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_cash_entry" model="ir.actions.act_window">
        <field name="name">Entradas de Caja</field>
        <field name="res_model">cash.entry</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_cash_entry_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registra la primera entrada de caja</p>
            <p>La caja es un libro manual e independiente: cada entrada se captura
               aquí (con o sin recibo) y suma al saldo del dashboard. Puedes ligar
               pedidos de venta por su folio o el recibo que la respalda.</p>
        </field>
    </record>

</odoo>
