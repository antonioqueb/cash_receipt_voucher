<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reporte PDF de la Salida de Caja. Sin binding al menú Imprimir:
         se imprime desde el botón del formulario (grupo de control interno).
         Branding alineado a los reportes de stock_lot_dimensions
         (external_layout + encabezado 800 + tablas #d8d8d8 / #f2f2f2). -->
    <record id="action_report_cash_disbursement" model="ir.actions.report">
        <field name="name">Salida de Caja</field>
        <field name="model">cash.disbursement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cash_receipt_voucher.report_cash_disbursement</field>
        <field name="report_file">cash_receipt_voucher.report_cash_disbursement</field>
        <field name="print_report_name">'Salida de Caja - %s' % (object.name or '')</field>
    </record>

    <template id="report_cash_disbursement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000; line-height: 1.25;">

                        <!-- ENCABEZADO -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Salida de Caja <span t-field="o.name" style="margin-left: 10px; color: #333;"/>
                                </h4>
                                <div style="font-size: 9px; color: #666;">Documento interno — no entregar al cliente</div>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 14px; color: #505050; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN GENERAL -->
                        <div id="informations" style="margin-bottom: 12px; font-size: 10px;">
                            <table style="font-size: 9px; width: 100%; border-collapse: collapse; border: 1px solid #d8d8d8 !important; table-layout: fixed;">
                                <colgroup>
                                    <col style="width: 38%;"/>
                                    <col style="width: 32%;"/>
                                    <col style="width: 30%;"/>
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th style="padding: 6px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px; background-color: #f2f2f2; color: #222; border: 1px solid #d8d8d8 !important;">Entregado a</th>
                                        <th style="padding: 6px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px; background-color: #f2f2f2; color: #222; border: 1px solid #d8d8d8 !important;">Detalle de la Salida</th>
                                        <th style="padding: 6px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px; background-color: #f2f2f2; color: #222; border: 1px solid #d8d8d8 !important;">Control Interno</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <!-- ENTREGADO A -->
                                        <td style="vertical-align: top; padding: 0; border: 1px solid #d8d8d8 !important;">
                                            <div style="padding: 6px 8px; overflow-wrap: anywhere; word-break: break-word;">
                                                <span style="font-weight: bold; font-size: 11px;" t-field="o.delivered_to"/>
                                            </div>
                                            <div t-if="o.partner_id" style="padding: 0 8px 6px 8px; font-size: 9px; color: #333;">
                                                <strong style="font-size: 8.5px; text-transform: uppercase; color: #555; display: block; letter-spacing: 0.3px;">Contacto</strong>
                                                <span t-field="o.partner_id.name"/>
                                            </div>
                                        </td>

                                        <!-- DETALLE -->
                                        <td style="vertical-align: top; padding: 0; border: 1px solid #d8d8d8 !important;">
                                            <div style="display: table; width: 100%; table-layout: fixed; border-bottom: 1px solid #d8d8d8 !important;">
                                                <div style="display: table-cell; width: 38%; padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px; border-right: 1px solid #d8d8d8 !important;">Fecha</div>
                                                <div style="display: table-cell; padding: 5px 8px; font-weight: 600;">
                                                    <span t-field="o.date" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/>
                                                </div>
                                            </div>
                                            <div style="display: table; width: 100%; table-layout: fixed;">
                                                <div style="display: table-cell; width: 38%; padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px; border-right: 1px solid #d8d8d8 !important;">Divisa</div>
                                                <div style="display: table-cell; padding: 5px 8px; font-weight: 600;">
                                                    <span t-field="o.currency_id.name"/>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- CONTROL INTERNO -->
                                        <td style="vertical-align: top; padding: 0; border: 1px solid #d8d8d8 !important;">
                                            <div style="display: table; width: 100%; table-layout: fixed; border-bottom: 1px solid #d8d8d8 !important;">
                                                <div style="display: table-cell; width: 45%; padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px; border-right: 1px solid #d8d8d8 !important;">Responsable</div>
                                                <div style="display: table-cell; padding: 5px 8px; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;">
                                                    <span t-field="o.user_id.name"/>
                                                </div>
                                            </div>
                                            <div style="display: table; width: 100%; table-layout: fixed;">
                                                <div style="display: table-cell; width: 45%; padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px; border-right: 1px solid #d8d8d8 !important;">Estado</div>
                                                <div style="display: table-cell; padding: 5px 8px; font-weight: 600;">
                                                    <span t-esc="'Registrada' if o.state == 'done' else 'Cancelada'"/>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- MONTO -->
                        <div style="margin: 14px 0; border: 1px solid #d8d8d8; background-color: #f2f2f2; padding: 12px; text-align: center;">
                            <div style="font-size: 8.5px; text-transform: uppercase; letter-spacing: 0.5px; color: #555;">Monto entregado</div>
                            <div style="font-size: 24px; font-weight: 800; color: #000;">
                                <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                            <div t-if="o.currency_id != o.mxn_currency_id" style="font-size: 9px; color: #555;">
                                Equivalente: <span t-field="o.amount_mxn" t-options="{'widget': 'monetary', 'display_currency': o.mxn_currency_id}"/>
                                (tipo de cambio de la fecha)
                            </div>
                        </div>

                        <!-- CONCEPTO -->
                        <table style="font-size: 9px; width: 100%; border-collapse: collapse; border: 1px solid #d8d8d8 !important; margin-bottom: 10px;">
                            <thead>
                                <tr>
                                    <th style="padding: 6px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px; background-color: #f2f2f2; color: #222; border: 1px solid #d8d8d8 !important;">Concepto / Motivo Interno</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #d8d8d8 !important; font-size: 10px; line-height: 1.35; white-space: pre-line; overflow-wrap: anywhere; word-break: break-word;">
                                        <span t-field="o.concept"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- FIRMAS -->
                        <div class="row" style="margin-top: 70px;">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; margin: 0 30px; padding-top: 6px; font-size: 9.5px;">
                                    <strong>Entregó</strong>
                                    <div style="color: #555; font-size: 8.5px;" t-esc="o.user_id.name"/>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; margin: 0 30px; padding-top: 6px; font-size: 9.5px;">
                                    <strong>Recibió</strong>
                                    <div style="color: #555; font-size: 8.5px;" t-esc="o.delivered_to"/>
                                </div>
                            </div>
                        </div>

                        <!-- CONFIDENCIAL -->
                        <div style="margin-top: 20px; border: 1px solid #ccc; padding: 8px; background-color: #fafafa; font-size: 9px; color: #555;">
                            <strong style="color: #333;">CONFIDENCIAL.</strong>
                            Este documento es de uso interno y contiene información sensible. No debe ser compartido con terceros sin autorización expresa.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
