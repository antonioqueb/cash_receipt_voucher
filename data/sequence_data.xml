<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cash_disbursement" model="ir.sequence">
            <field name="name">Salida de Caja</field>
            <field name="code">cash.disbursement</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">SAL-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_cash_entry" model="ir.sequence">
            <field name="name">Entrada de Caja</field>
            <field name="code">cash.entry</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">ENT-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_in" model="ir.sequence">
            <field name="name">Caja Chica · Ingreso</field>
            <field name="code">petty.cash.in</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">CCH-I-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_petty_cash_out" model="ir.sequence">
            <field name="name">Caja Chica · Egreso</field>
            <field name="code">petty.cash.out</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">CCH-E-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_cash_receipt" model="ir.sequence">
            <field name="name">Recibo de Efectivo</field>
            <field name="code">cash.receipt</field>
            <field name="implementation">no_gap</field>
            <field name="prefix">REC-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
